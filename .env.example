# Copy to .env and fill in. .env is ignored by git.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Folder of markdown files to index (relative to this folder, or absolute).
# samples/library is the bundled sample; use library/ (git-ignored) for your own documents.
DOCS_PATH=samples/library

# Optional overrides
# CHROMA_PATH=chroma_db
# COLLECTION_NAME=documents
# CAPPED_SOURCE_TYPE=report
# CAPPED_SOURCE_MAX=3
# BOOSTED_SOURCE_TYPES=article,analysis
# BOOST_FACTOR=1.5

# Models (defaults shown)
# CHAT_MODEL=claude-sonnet-5-5
# AUTOTAG_MODEL=claude-haiku-5-5
# CHAT_EFFORT=medium

# Contextual retrieval (see README). Changing these re-indexes each file once.
# CONTEXTUAL_CHUNKS=true
# CHUNK_SIZE_TOKENS=200
# CONTEXT_WORKERS=8
